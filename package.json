{
  "name": "skatt-calculator",
  "version": "1.0.0",
  "description": "Swedish Tax Calculator",
  "main": "src/index.tsx",
  "scripts": {
    "prebuild": "rm -rf dist",
    "build": "webpack --mode=production",
    "postbuild": "rm dist/**/*.LICENSE.txt",
    "dev": "webpack serve --mode=development",
    "eslint:check": "eslint src",
    "eslint:fix": "eslint src --fix",
    "stylelint:check": "stylelint **/*.scss",
    "stylelint:fix": "stylelint **/*.scss --fix",
    "prettier:check": "prettier . --check",
    "prettier:fix": "prettier . --write",
    "test": "jest",
    "predeploy": "npm run build",
    "deploy": "rsync -avz ./dist/ rpi:skatt",
    "postdeploy": "ssh rpi 'sudo ./www-deploy.sh'"
  },
  "keywords": [],
  "author": "Steve Bunting",
  "license": "ISC",
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@teamsupercell/typings-for-css-modules-loader": "^2.5.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.9",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/webpack": "^5.28.5",
    "@types/webpack-dev-server": "^4.7.1",
    "css-loader": "^7.1.2",
    "eslint": "^9.21.0",
    "eslint-config-prettier": "^10.0.2",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-webpack-plugin": "^5.0.0",
    "globals": "^16.0.0",
    "html-webpack-plugin": "^5.5.0",
    "jest": "^29.7.0",
    "mini-css-extract-plugin": "^2.6.0",
    "prettier": "^3.5.3",
    "sass": "^1.85.1",
    "sass-loader": "^16.0.5",
    "stylelint": "^16.15.0",
    "stylelint-config-standard-scss": "^14.0.0",
    "stylelint-webpack-plugin": "^5.0.1",
    "ts-jest": "^29.2.6",
    "ts-loader": "^9.2.8",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.0",
    "webpack": "^5.71.0",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.0"
  }
}
